@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 85vh;">
    <div class="glass-card p-5 text-center shadow-lg" style="max-width: 500px;">
        
        <div class="mb-4">
            <i class="bi bi-shield-lock text-danger" style="font-size: 4rem;"></i>
        </div>

        <h2 class="fw-bold mb-3">Access Denied</h2>

        <p class="mb-4 text-light">
            You do not have permission to view this page.<br/>
            If you believe this is an error, contact the administrator.
        </p>

        <a asp-area="" asp-controller="Home" asp-action="Index"
           class="btn btn-outline-light rounded-3 px-4 py-2 shadow-sm">
            ← Back to Home
        </a>

    </div>
</div>

    <partial name="_ValidationScriptsPartial" />