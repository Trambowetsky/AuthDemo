@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="glass-card p-4 shadow-lg" style="width: 380px;">
        <h3 class="text-center mb-4 fw-bold">Welcome back</h3>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mb-3">
                <div class="form-check">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label class="form-check-label" asp-for="Input.RememberMe"></label>
                </div>
                <a asp-page="./ForgotPassword" class="small text-decoration-none">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-3 py-2">
                Sign In
            </button>

            <div class="text-center mt-3">
                <span class="text-muted small">Don't have an account?</span>
                <a asp-page="./Register" class="text-decoration-none fw-semibold">Sign up</a>
                <a class="btn btn-outline-dark" href="~/signin-github">Sign in with GitHub</a>
            </div>
        </form>
    </div>
</div>

    <partial name="_ValidationScriptsPartial" />
