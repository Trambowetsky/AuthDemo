@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
    <div class="glass-card p-4 shadow-lg" style="width: 420px;">
        <h3 class="text-center mb-4 fw-bold">Create your account</h3>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-semibold"></label>
                <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-semibold"></label>
                <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-3 py-2">
                Create account
            </button>

            <div class="text-center mt-3">
                <span class="text-muted small">Already registered?</span>
                <a asp-page="./Login" class="text-decoration-none fw-semibold">Sign in</a>
            </div>
        </form>
    </div>
</div>

    <partial name="_ValidationScriptsPartial" />
