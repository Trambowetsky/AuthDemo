@model List<AuthDemo.Models.UserViewModel>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-5">
    <h2 class="mb-4 fw-bold text-center">User Management</h2>

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>Roles</th>
            <th style="width: 150px;">Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Email</td>
                <td>
                    @if (user.Roles != null && user.Roles.Count > 0)
                    {
                        <span class="badge bg-primary">@string.Join("</span> <span class='badge bg-primary'>", user.Roles)</span>
                    }
                    else
                    {
                        <span class="text-muted">No roles</span>
                    }
                </td>
                <td>
                    <a asp-controller="Admin"
                       asp-action="EditRoles"
                       asp-route-id="@user.Id"
                       class="btn btn-sm btn-outline-primary">
                        Edit Roles
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>